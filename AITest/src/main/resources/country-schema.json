{
  "$schema": "https://json-schema.org",
  "type": "object",
  "required": ["data"],
  "properties": {
    "data": {
      "type": "object",
      "required": ["objects"],
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["names"],
            "properties": {
              "names": {
                "type": "object",
                "required": ["common"],
                "properties": {
                  "common": { "type": "string" },
                  "official": { "type": "string" },
                  "alternates": {
                    "type": "array",
                    "items": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
